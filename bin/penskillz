#!/usr/bin/env python3
"""penskillz — extract and install pentesting skills from upstream frameworks.

Usage:
  penskillz sync                       Clone/update all git sources (submodules + pinned refs).
  penskillz extract [SOURCE...]        Run extractors -> dist/skills/.
  penskillz install [--agent NAME]     Copy dist/skills into agent skill dirs.
                                       --agent: claude-code (default), codex, qwen.
                                       Use --agent all to install everywhere detected.
  penskillz update                     sync + extract + install (one-shot refresh).
  penskillz list                       List sources and extracted skills.
  penskillz status                     Show source revs and install state.
  penskillz add-source NAME URL [opts] Register a new upstream source in sources.yaml.
                                       Options: --path P  --ref R  --extractor E  --prefix X.
  penskillz remove-source NAME         Drop a source (does not delete cached clone).
  penskillz doctor                     Diagnose environment + agent skill dirs.
  penskillz summarize                  Rebuild the penskillz-capabilities meta-skill
                                       and CAPABILITIES.md from the current index.

Environment:
  PENSKILLZ_HOME      Project root (default: parent dir of this script).
  PENSKILLZ_PREFIX    Override install prefix (default per agent below).
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from dataclasses import dataclass, field
from pathlib import Path
from typing import Iterable

ROOT = Path(os.environ.get("PENSKILLZ_HOME") or Path(__file__).resolve().parent.parent)
SOURCES_DIR = ROOT / "sources"
DIST_DIR = ROOT / "dist" / "skills"
LIB_DIR = ROOT / "lib"
SOURCES_YAML = ROOT / "sources.yaml"

sys.path.insert(0, str(LIB_DIR))

AGENT_TARGETS = {
    # Each entry: env override key, default install dir.
    "claude-code": ("CLAUDE_SKILLS_DIR", Path.home() / ".claude" / "skills"),
    "codex": ("CODEX_SKILLS_DIR", Path.home() / ".codex" / "skills"),
    "qwen": ("QWEN_SKILLS_DIR", Path.home() / ".qwen" / "skills"),
}


# ---- minimal YAML loader (no external deps) ----------------------------------

def _yaml_load(text: str):
    """Tiny YAML subset: maps, lists, scalars, comments. Enough for sources.yaml."""
    try:
        import yaml  # type: ignore
        return yaml.safe_load(text)
    except Exception:
        pass

    lines = [ln.rstrip() for ln in text.splitlines()]

    def parse_scalar(s: str):
        s = s.strip()
        if not s:
            return None
        if s[0] in "\"'" and s[-1] == s[0]:
            return s[1:-1]
        if s.lower() in {"true", "false"}:
            return s.lower() == "true"
        if s.lower() in {"null", "~"}:
            return None
        return s

    def block(indent: int, i: int):
        # Returns (value, next_index)
        # Decide list-vs-map by first non-blank/non-comment line at this indent.
        result = None
        while i < len(lines):
            raw = lines[i]
            if not raw.strip() or raw.lstrip().startswith("#"):
                i += 1
                continue
            cur_indent = len(raw) - len(raw.lstrip())
            if cur_indent < indent:
                return result, i
            stripped = raw.lstrip()
            if stripped.startswith("- "):
                if result is None:
                    result = []
                if not isinstance(result, list):
                    return result, i
                item_body = stripped[2:]
                # Inline scalar list item
                if ":" not in item_body or item_body.endswith(":"):
                    if item_body.endswith(":"):
                        # Rare; treat as map start at deeper indent
                        sub, i = block(cur_indent + 2, i + 1)
                        result.append({item_body[:-1].strip(): sub})
                    else:
                        result.append(parse_scalar(item_body))
                        i += 1
                else:
                    # Map starting at this dash. First key:value on same line.
                    first_key, _, first_val = item_body.partition(":")
                    entry = {}
                    fv = first_val.strip()
                    if fv:
                        entry[first_key.strip()] = parse_scalar(fv)
                    sub, i = block(cur_indent + 2, i + 1)
                    if isinstance(sub, dict):
                        entry.update(sub)
                    elif isinstance(sub, list) and not fv:
                        entry[first_key.strip()] = sub
                    result.append(entry)
            else:
                if result is None:
                    result = {}
                if not isinstance(result, dict):
                    return result, i
                key, _, val = stripped.partition(":")
                key = key.strip()
                val = val.strip()
                if val:
                    result[key] = parse_scalar(val)
                    i += 1
                else:
                    sub, i = block(cur_indent + 2, i + 1)
                    result[key] = sub if sub is not None else {}
        return result, i

    out, _ = block(0, 0)
    return out or {}


def _yaml_dump(data) -> str:
    try:
        import yaml  # type: ignore
        return yaml.safe_dump(data, sort_keys=False)
    except Exception:
        pass
    # Fallback: dump via json for safety. Round-trips lose comments but is valid YAML.
    return json.dumps(data, indent=2)


# ---- data model --------------------------------------------------------------

@dataclass
class Source:
    name: str
    url: str
    ref: str = "main"
    path: str = ""
    extractor: str = "strix"
    prefix: str = ""
    exclude: list = field(default_factory=list)
    include: list = field(default_factory=list)
    license: str = ""
    options: dict = field(default_factory=dict)

    @classmethod
    def from_dict(cls, d: dict) -> "Source":
        return cls(
            name=d["name"],
            url=d["url"],
            ref=d.get("ref") or "main",
            path=d.get("path") or "",
            extractor=d.get("extractor") or "strix",
            prefix=d.get("prefix") or "",
            exclude=list(d.get("exclude") or []),
            include=list(d.get("include") or []),
            license=d.get("license") or "",
            options=dict(d.get("options") or {}),
        )

    def to_dict(self) -> dict:
        out = {"name": self.name, "url": self.url, "ref": self.ref}
        if self.path:
            out["path"] = self.path
        out["extractor"] = self.extractor
        if self.prefix:
            out["prefix"] = self.prefix
        if self.include:
            out["include"] = self.include
        if self.exclude:
            out["exclude"] = self.exclude
        if self.license:
            out["license"] = self.license
        if self.options:
            out["options"] = self.options
        return out

    def checkout_dir(self) -> Path:
        return SOURCES_DIR / self.name

    def skills_root(self) -> Path:
        return self.checkout_dir() / self.path if self.path else self.checkout_dir()


def load_sources() -> list[Source]:
    if not SOURCES_YAML.exists():
        return []
    data = _yaml_load(SOURCES_YAML.read_text()) or {}
    return [Source.from_dict(s) for s in (data.get("sources") or [])]


def save_sources(sources: list[Source]) -> None:
    SOURCES_YAML.write_text(_yaml_dump({"sources": [s.to_dict() for s in sources]}))


# ---- git operations ----------------------------------------------------------

def _run(cmd: list[str], cwd: Path | None = None, check: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, cwd=cwd, check=check, text=True, capture_output=True)


def git_sync(src: Source, *, log) -> None:
    dest = src.checkout_dir()
    SOURCES_DIR.mkdir(parents=True, exist_ok=True)
    if not dest.exists():
        log(f"[sync] cloning {src.name} <- {src.url}")
        _run(["git", "clone", "--depth", "1", "--branch", src.ref, src.url, str(dest)], check=False)
        if not (dest / ".git").exists():
            # branch flag may have failed (e.g. tag/commit). Fall back.
            shutil.rmtree(dest, ignore_errors=True)
            _run(["git", "clone", src.url, str(dest)])
            _run(["git", "checkout", src.ref], cwd=dest)
    else:
        log(f"[sync] updating {src.name}")
        _run(["git", "fetch", "--depth", "1", "origin", src.ref], cwd=dest, check=False)
        _run(["git", "checkout", src.ref], cwd=dest, check=False)
        _run(["git", "reset", "--hard", f"origin/{src.ref}"], cwd=dest, check=False)


def git_rev(src: Source) -> str:
    try:
        cp = _run(["git", "rev-parse", "--short", "HEAD"], cwd=src.checkout_dir())
        return cp.stdout.strip()
    except Exception:
        return "?"


# ---- extraction --------------------------------------------------------------

def _load_extractor(name: str):
    module_path = LIB_DIR / "extractors" / f"{name}.py"
    if not module_path.exists():
        raise SystemExit(f"unknown extractor: {name} (looked at {module_path})")
    import importlib.util
    spec = importlib.util.spec_from_file_location(f"penskillz_ex_{name}", module_path)
    mod = importlib.util.module_from_spec(spec)  # type: ignore[arg-type]
    assert spec and spec.loader
    spec.loader.exec_module(mod)  # type: ignore[union-attr]
    if not hasattr(mod, "extract"):
        raise SystemExit(f"extractor {name} missing extract(src, dest) function")
    return mod


def extract_sources(sources: list[Source], *, log) -> int:
    DIST_DIR.mkdir(parents=True, exist_ok=True)
    total = 0
    for src in sources:
        if not src.skills_root().exists():
            log(f"[extract] skip {src.name}: not synced (run `penskillz sync`)")
            continue
        ex = _load_extractor(src.extractor)
        out_dir = DIST_DIR / src.name
        if out_dir.exists():
            shutil.rmtree(out_dir)
        out_dir.mkdir(parents=True)
        count = ex.extract(src=src, dest=out_dir, log=log)
        log(f"[extract] {src.name}: {count} skills")
        total += count
    # Write top-level index manifest, then build the capabilities meta-skill.
    write_index()
    build_capabilities_summary(log=log)
    return total


def build_capabilities_summary(*, log) -> None:
    """Build the penskillz-capabilities meta-skill + pinned CAPABILITIES.md.

    Imported lazily so an extractor failure doesn't prevent the summary
    from being usable in isolation.
    """
    from summary import build_summary  # type: ignore[import-not-found]
    meta_path, pinned_path = build_summary(ROOT)
    log(f"[summary] meta-skill -> {meta_path.relative_to(ROOT)}")
    log(f"[summary] pinned     -> {pinned_path.relative_to(ROOT)}")


def write_index() -> None:
    entries = []
    for src_dir in sorted(p for p in DIST_DIR.iterdir() if p.is_dir()) if DIST_DIR.exists() else []:
        # Skip the meta directory — it's the summary output, not source skills.
        if src_dir.name == "_meta":
            continue
        for skill_dir in sorted(p for p in src_dir.iterdir() if p.is_dir()):
            skill_md = skill_dir / "SKILL.md"
            if not skill_md.exists():
                continue
            name, desc = _read_frontmatter(skill_md)
            entries.append({
                "source": src_dir.name,
                "name": name or skill_dir.name,
                "description": desc or "",
                "path": str(skill_md.relative_to(ROOT)),
            })
    (DIST_DIR / "index.json").write_text(json.dumps(entries, indent=2))


_FM = re.compile(r"^---\s*\n(.*?)\n---\s*\n", re.DOTALL)


def _read_frontmatter(path: Path) -> tuple[str, str]:
    text = path.read_text(encoding="utf-8", errors="replace")
    m = _FM.match(text)
    if not m:
        return "", ""
    name = ""
    desc = ""
    for line in m.group(1).splitlines():
        if line.startswith("name:"):
            name = line.split(":", 1)[1].strip().strip('"').strip("'")
        elif line.startswith("description:"):
            desc = line.split(":", 1)[1].strip().strip('"').strip("'")
    return name, desc


# ---- agent install -----------------------------------------------------------

def resolve_agent_dir(agent: str) -> Path:
    if os.environ.get("PENSKILLZ_PREFIX"):
        return Path(os.environ["PENSKILLZ_PREFIX"])
    env_key, default = AGENT_TARGETS[agent]
    return Path(os.environ.get(env_key) or default)


def install_for_agent(agent: str, *, log) -> int:
    if not DIST_DIR.exists():
        raise SystemExit("nothing extracted yet — run `penskillz extract` first")
    target = resolve_agent_dir(agent)
    target.mkdir(parents=True, exist_ok=True)
    count = 0
    marker = ".penskillz-managed"
    for src_dir in sorted(p for p in DIST_DIR.iterdir() if p.is_dir()):
        for skill_dir in sorted(p for p in src_dir.iterdir() if p.is_dir()):
            skill_md = skill_dir / "SKILL.md"
            if not skill_md.exists():
                continue
            dest_dir = target / skill_dir.name
            # Refuse to overwrite a non-managed skill of the same name.
            if dest_dir.exists() and not (dest_dir / marker).exists():
                log(f"[install] skip {skill_dir.name}: exists and is not penskillz-managed")
                continue
            if dest_dir.exists():
                shutil.rmtree(dest_dir)
            shutil.copytree(skill_dir, dest_dir)
            (dest_dir / marker).write_text(f"source={src_dir.name}\n")
            count += 1
    log(f"[install] {agent}: {count} skills -> {target}")
    return count


def install(agent: str, *, log) -> int:
    if agent == "all":
        total = 0
        for a in AGENT_TARGETS:
            total += install_for_agent(a, log=log)
        return total
    if agent not in AGENT_TARGETS:
        raise SystemExit(f"unknown agent: {agent} (choices: {', '.join(AGENT_TARGETS)} | all)")
    return install_for_agent(agent, log=log)


# ---- command handlers --------------------------------------------------------

def cmd_sync(args, log):
    sources = load_sources()
    if args.source:
        sources = [s for s in sources if s.name in set(args.source)]
    for src in sources:
        git_sync(src, log=log)


def cmd_extract(args, log):
    sources = load_sources()
    if args.source:
        sources = [s for s in sources if s.name in set(args.source)]
    extract_sources(sources, log=log)


def cmd_install(args, log):
    install(args.agent, log=log)


def cmd_update(args, log):
    sources = load_sources()
    for src in sources:
        git_sync(src, log=log)
    extract_sources(sources, log=log)
    install(args.agent, log=log)


def cmd_list(args, log):
    sources = load_sources()
    print("Sources:")
    for s in sources:
        print(f"  - {s.name:<14} {s.url}  @{s.ref}  via {s.extractor}")
    if DIST_DIR.exists():
        idx = DIST_DIR / "index.json"
        if idx.exists():
            entries = json.loads(idx.read_text())
            print(f"\nExtracted skills ({len(entries)}):")
            for e in entries:
                print(f"  - {e['name']:<40} [{e['source']}]  {e['description'][:80]}")


def cmd_status(args, log):
    sources = load_sources()
    print(f"Project root : {ROOT}")
    print(f"Sources dir  : {SOURCES_DIR}")
    print(f"Dist dir     : {DIST_DIR}")
    print()
    for s in sources:
        synced = "yes" if s.checkout_dir().exists() else "no"
        rev = git_rev(s) if synced == "yes" else "-"
        print(f"  {s.name:<14} synced={synced} ref={s.ref} rev={rev}")
    print()
    for a, (env, default) in AGENT_TARGETS.items():
        d = resolve_agent_dir(a)
        installed = sum(1 for p in d.glob("*/.penskillz-managed")) if d.exists() else 0
        print(f"  {a:<12} dir={d} installed={installed}")


def cmd_add_source(args, log):
    sources = load_sources()
    if any(s.name == args.name for s in sources):
        raise SystemExit(f"source {args.name} already exists")
    sources.append(Source(
        name=args.name, url=args.url, ref=args.ref or "main",
        path=args.path or "", extractor=args.extractor or "strix",
        prefix=args.prefix or "",
    ))
    save_sources(sources)
    log(f"[add-source] registered {args.name}")
    log("Next: penskillz sync && penskillz extract && penskillz install")


def cmd_remove_source(args, log):
    sources = load_sources()
    new = [s for s in sources if s.name != args.name]
    if len(new) == len(sources):
        raise SystemExit(f"no such source: {args.name}")
    save_sources(new)
    log(f"[remove-source] dropped {args.name} (clone at sources/{args.name} not deleted)")


def cmd_summarize(args, log):
    if not (DIST_DIR / "index.json").exists():
        # The index is the input to the summary. Rebuild it cheaply from disk
        # so `penskillz summarize` works after a manual edit too.
        write_index()
    build_capabilities_summary(log=log)


def cmd_doctor(args, log):
    ok = True
    if not shutil.which("git"):
        log("FAIL: git not on PATH"); ok = False
    if sys.version_info < (3, 9):
        log("FAIL: python >= 3.9 required"); ok = False
    if not SOURCES_YAML.exists():
        log("WARN: sources.yaml missing"); ok = False
    for a, (_, d) in AGENT_TARGETS.items():
        path = resolve_agent_dir(a)
        log(f"  agent={a:<12} dir={path} exists={path.exists()}")
    log("OK" if ok else "issues found")


# ---- argparse ----------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="penskillz", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("sync"); sp.add_argument("source", nargs="*"); sp.set_defaults(func=cmd_sync)
    sp = sub.add_parser("extract"); sp.add_argument("source", nargs="*"); sp.set_defaults(func=cmd_extract)
    sp = sub.add_parser("install")
    sp.add_argument("--agent", default="claude-code"); sp.set_defaults(func=cmd_install)
    sp = sub.add_parser("update")
    sp.add_argument("--agent", default="claude-code"); sp.set_defaults(func=cmd_update)
    sub.add_parser("list").set_defaults(func=cmd_list)
    sub.add_parser("status").set_defaults(func=cmd_status)
    sp = sub.add_parser("add-source")
    sp.add_argument("name"); sp.add_argument("url")
    sp.add_argument("--ref"); sp.add_argument("--path")
    sp.add_argument("--extractor"); sp.add_argument("--prefix")
    sp.set_defaults(func=cmd_add_source)
    sp = sub.add_parser("remove-source"); sp.add_argument("name"); sp.set_defaults(func=cmd_remove_source)
    sub.add_parser("doctor").set_defaults(func=cmd_doctor)
    sub.add_parser("summarize").set_defaults(func=cmd_summarize)
    return p


def main(argv: Iterable[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    def log(msg): print(msg, file=sys.stderr)
    args.func(args, log)
    return 0


if __name__ == "__main__":
    sys.exit(main())
